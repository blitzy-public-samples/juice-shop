# ==============================================================================
# OWASP Juice Shop — Environment Configuration Template
# ==============================================================================
# Copy this file to `.env` and replace the placeholder values below.
# DO NOT commit a real `.env` — this `.env.example` contains placeholders only.
#
# Introduced by the Broken Authentication remediation (OWASP A07:2021) to move
# secrets out of source code. See lib/insecurity.ts and server.ts for consumers.
#
# Variable names follow the existing `process.env.*` convention already used in
# the codebase (e.g. CTF_KEY, BASE_PATH, PORT). Real secret values are supplied
# at runtime via a local, uncommitted `.env` or the deployment environment —
# never in this template.
# ------------------------------------------------------------------------------

# --- REQUIRED: JWT signing key (RS256) ----------------------------------------
# RSA PRIVATE key used to sign session JWTs (lib/insecurity.ts `authorize()`).
# Generate one with, e.g.:  openssl genrsa -out encryptionkeys/jwt.key 2048
#
# Option A — inline PEM (escape line breaks as \n):
JWT_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nREPLACE_WITH_YOUR_RSA_PRIVATE_KEY\n-----END RSA PRIVATE KEY-----"
#
# Option B — path to a PEM file on disk (used as a fallback so local/dev boots
# still succeed when JWT_PRIVATE_KEY is unset). Uncomment to use this instead:
# JWT_PRIVATE_KEY_PATH=encryptionkeys/jwt.key
#
# The matching PUBLIC key for verification remains at encryptionkeys/jwt.pub.

# --- REQUIRED: HMAC secret -----------------------------------------------------
# Secret for HMAC-SHA256 (lib/insecurity.ts `hmac()`). Use a strong random value
# of at least 256 bits (e.g. `openssl rand -base64 48`).
HMAC_SECRET=REPLACE_WITH_A_LONG_RANDOM_SECRET

# --- OPTIONAL: Seeded admin password override ----------------------------------
# If set, overrides the default seeded admin password (otherwise the value in
# data/static/users.yml is used as the fallback). Leave unset to keep the seed default.
# ADMIN_PASSWORD=REPLACE_WITH_A_STRONG_ADMIN_PASSWORD

# --- OPTIONAL: Cookie signing secret -------------------------------------------
# If externalized, replaces the hardcoded cookie-parser secret in server.ts.
# COOKIE_SECRET=REPLACE_WITH_A_RANDOM_COOKIE_SECRET
